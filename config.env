# ---- Edit these values, then run the scripts in order ----
export AWS_REGION="ap-south-1"          # Mumbai
export AZ="ap-south-1a"                 # same AZ for every subnet (lab simplicity)
export STUDENT_NAME="Your Name"         # used in the Student tag
export PROJECT_TAG="EWB-VPC-Peering"

export INSTANCE_TYPE="t3.micro"         # check pricing / free-tier eligibility in your account
export KEY_NAME="ewb-lab"
export KEY_FILE="$HOME/.ssh/ewb-lab.pem"

# Address plan
export VPC_A_CIDR="10.10.0.0/16"
export SUBNET_A_PUBLIC_CIDR="10.10.1.0/24"
export SUBNET_A_PRIVATE_CIDR="10.10.2.0/24"
export VPC_B_CIDR="10.20.0.0/16"
export SUBNET_B_PRIVATE_CIDR="10.20.1.0/24"

export BASTION_IP="10.10.1.10"
export APP_A_IP="10.10.2.10"
export APP_B_IP="10.20.1.10"
